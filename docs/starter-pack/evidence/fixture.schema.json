{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sanitized workshop evidence fixture",
  "description": "Teaching format defined for this package. It is not a Visualping API or webhook payload. All proposed_review values are workshop placeholders.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "example_id",
    "title",
    "primary_workshop_input",
    "source",
    "observed_at",
    "previous_capture_at",
    "source_published_at",
    "source_dates",
    "saved_alert",
    "verified_observation",
    "assets",
    "proposed_review",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "example_id": {
      "type": "string",
      "pattern": "^[a-z]+(?:-[a-z]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "primary_workshop_input": {
      "type": "boolean"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "url"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "previous_capture_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "source_published_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "source_dates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "value",
          "scope"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string",
            "format": "date"
          },
          "scope": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "saved_alert": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verification",
        "important",
        "ai_summary",
        "watch_rule"
      ],
      "properties": {
        "verification": {
          "enum": [
            "reproduced_from_saved_event",
            "not_verified_for_this_package"
          ]
        },
        "important": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "ai_summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "watch_rule": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "verified_observation": {
      "type": "string",
      "minLength": 1
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comparison",
        "before"
      ],
      "properties": {
        "comparison": {
          "type": "string",
          "pattern": "^\\.\\./assets/[^/]+\\.(jpg|png)$"
        },
        "before": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\.\\./assets/[^/]+\\.(jpg|png)$"
        }
      }
    },
    "proposed_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "owner",
        "backup",
        "next_action",
        "decision"
      ],
      "properties": {
        "status": {
          "const": "proposed_not_executed"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "backup": {
          "type": "string",
          "minLength": 1
        },
        "next_action": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "saved_alert": {
            "properties": {
              "verification": {
                "const": "reproduced_from_saved_event"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "saved_alert": {
            "properties": {
              "important": {
                "type": "boolean"
              },
              "ai_summary": {
                "type": "string",
                "minLength": 1
              },
              "watch_rule": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "saved_alert": {
            "properties": {
              "important": {
                "type": "null"
              },
              "ai_summary": {
                "type": "null"
              },
              "watch_rule": {
                "type": "null"
              }
            }
          }
        }
      }
    }
  ]
}
